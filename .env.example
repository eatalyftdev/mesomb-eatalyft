# ============================================================
# EataLyft Payment Microservice — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000

# ------ MeSomb Credentials --------------------------------
# Get these from: https://mesomb.business/applications/
MESOMB_APPLICATION_KEY=
MESOMB_ACCESS_KEY=
MESOMB_SECRET_KEY=

# Webhook signing secret (whsec_... from your MeSomb dashboard)
# Used for HMAC-SHA256 signature verification on /webhooks/mesomb
MESOMB_WEBHOOK_SECRET=

# API version date (use 2026-05-01 or latest)
MESOMB_API_VERSION=2026-05-01

# Set to "false" for sandbox/test mode
MESOMB_LIVEMODE=true

# ------ Supabase ------------------------------------------
# Service role key — bypasses RLS; keep this secret
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------ Firebase ------------------------------------------
# Only required if using Firebase Auth / session cookies
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------ Webhook Security ----------------------------------
# Max age in seconds before a webhook is rejected (replay-attack protection)
# Default: 300 (5 minutes)
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
