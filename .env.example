# ═══════════════════════════════════════════════════════════════════════════
# EataLyft Payment Microservice — Environment Configuration (v2.0.0)
# ═══════════════════════════════════════════════════════════════════════════
# TWO-WEBHOOK ARCHITECTURE:
# This microservice verifies signatures, deduplicates events, and forwards
# them to the main app for authoritative processing.
# The main app is the SINGLE SOURCE OF TRUTH.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ─── MeSomb Credentials ─────────────────────────────────────────────────────
# Get these from: https://mesomb.business/applications/
MESOMB_APPLICATION_KEY=
MESOMB_ACCESS_KEY=
MESOMB_SECRET_KEY=

# API version date (use 2026-05-01 or latest)
MESOMB_API_VERSION=2026-05-01

# Set to "false" for sandbox/test mode, "true" for production
MESOMB_LIVEMODE=false

# ─── MeSomb Webhook Security ───────────────────────────────────────────────
# Get this from MeSomb dashboard → Settings → Webhooks → Signing Secret
# CRITICAL: Used to verify X-MeSomb-Webhook-Signature header
# Without this, all webhooks will be rejected with 401
MESOMB_WEBHOOK_SECRET=

# Max age in seconds before a webhook is rejected (replay-attack protection)
# Default: 300 (5 minutes)
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# ─── Main App → EataPay Authentication ─────────────────────────────────────
# Both secrets below must match the main app values, but they must be different
# secrets with different purposes. Generate each with: openssl rand -hex 32
# Internal server-to-server authentication header: X-Internal-Service-Key
EATAPAY_INTERNAL_KEY=
# Service authentication header: x-service-key
MESOMB_SERVICE_KEY=

# ─── Main App Configuration ────────────────────────────────────────────────
# URL of the main app's webhook endpoint
# This is where the microservice FORWARDS all events for processing
# CRITICAL: The main app owns wallet credits, mission activation, notifications
EATALYFT_MAIN_APP_URL=https://eatalyft.cm
# For local development:
# EATALYFT_MAIN_APP_URL=http://localhost:3000

# ─── Firebase / Firestore ──────────────────────────────────────────────────
# Used for idempotency records (mesomb_events collection) and audit logging
# Get these from your Firebase service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Supabase ────────────────────────────────────────────────────────────────
# The main app is authoritative, but these values are available for the
# microservice's optional audit/mirror integrations. Never hardcode credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

